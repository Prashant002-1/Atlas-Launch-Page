{
  "name": "atlas-launch-page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "test": "node --test tests/*.test.mjs",
    "validate:html": "html-validate '*.html' 'learn-more/*.html' 'about/*.html' 'security/*.html' 'notes/*.html' 'products/*.html' 'products/*/*.html' 'assessment/*.html' 'integrations/*.html' 'contact/*.html'",
    "validate:css": "csstree-validator .",
    "validate:refs": "node scripts/check-local-refs.mjs",
    "verify": "npm test && npm run validate:html && npm run validate:css && npm run validate:refs"
  },
  "devDependencies": {
    "csstree-validator": "^4.0.1",
    "html-validate": "^10.7.0"
  }
}
