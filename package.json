{
  "name": "atlas-launch-page",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:html": "html-validate '*.html' 'how-it-works/*.html' 'work-with-us/*.html' 'pricing/*.html' 'access/*.html'",
    "validate:css": "csstree-validator .",
    "verify": "npm test && npm run validate:html && npm run validate:css"
  },
  "devDependencies": {
    "csstree-validator": "^4.0.1",
    "html-validate": "^10.7.0"
  }
}
